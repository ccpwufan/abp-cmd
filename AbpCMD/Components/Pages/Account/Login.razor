@page "/Account/LoginNoPassword"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@using Volo.Abp.Account
@using AbpCMD.Services


@inject ICustomAccountAppService CustomAccountAppService
@inject NavigationManager NavigationManager

<h3>无密码登录</h3>

<EditForm Model="@loginInput" OnValidSubmit="HandleLoginWithoutPassword">
    <DataAnnotationsValidator />
    <Microsoft.AspNetCore.Components.Forms.ValidationSummary />

    <div>
        <label for="username">用户名:</label>
        <InputText id="username" @bind-Value="loginInput.Username" />
    </div>

    <button type="submit">登录</button>
</EditForm>

@code {
    private LoginWithoutPasswordInput loginInput = new LoginWithoutPasswordInput();

    private async Task HandleLoginWithoutPassword()
    {
        try
        {
            await CustomAccountAppService.LoginWithoutPasswordAsync(loginInput.Username);
            // 登录成功后导航到主页
            NavigationManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            // 处理登录失败的情况
            Console.WriteLine($"登录失败: {ex.Message}");
        }
    }

    public class LoginWithoutPasswordInput
    {
        public string Username { get; set; }
    }
}