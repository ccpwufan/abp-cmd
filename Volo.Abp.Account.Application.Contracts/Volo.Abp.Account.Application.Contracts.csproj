<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net9.0</TargetFrameworks>
    <AssemblyName>Volo.Abp.Account.Application.Contracts</AssemblyName>
    <PackageId>Volo.Abp.Account.Application.Contracts</PackageId>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <RootNamespace />
	<AssemblyVersion>9.0.4.0</AssemblyVersion>
    <!-- 文件版本，通常和程序集版本保持一致 -->
    <FileVersion>9.0.4.0</FileVersion>
    <!-- 包版本，用于 NuGet 包发布，如果有需要可以设置 -->
    <Version>9.0.4.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Volo\Abp\Account\Localization\Resources\*.json" />
    <Content Remove="Volo\Abp\Account\Localization\Resources\*.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Blazorise.Icons.FontAwesome" Version="1.6.2" />
    <PackageReference Include="Volo.Abp.Identity.Application.Contracts" Version="9.0.4" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="9.0.1" />
  </ItemGroup>
</Project>